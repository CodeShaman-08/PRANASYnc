# AI provider (optional — the deterministic engine works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Standalone Express API (/server)
PORT=4001
CLIENT_ORIGIN=*

# Only needed when the client and API are deployed separately.
# Leave blank for same-origin (Next.js route handler or a reverse proxy).
NEXT_PUBLIC_API_BASE=
